APP_NAME="Loan Suite"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://suite.maur.co.ke/git/public
ASSET_URL=https://suite.maur.co.ke/git/public
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Nairobi

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=crossha1_suite
DB_USERNAME=crossha1_suite
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=suite.maur.co.ke
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@suite.maur.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NAME="Loan Suite Admin"
ADMIN_EMAIL=admin@loansuite.local
ADMIN_PASSWORD=ChangeMe#2026
